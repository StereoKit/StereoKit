<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>StereoKitTest</RootNamespace>
		<NoWarn>1701;1702;1573;CS1587;CS0618</NoWarn>

		<!-- AOT requires trimming, but Tests.FindTests discovers scenes with
		     GetTypes(), so root this assembly whole and let the framework trim
		     normally around it. -->
		<PublishTrimmed>true</PublishTrimmed>

		<SKAssetFolder>..\..\Assets</SKAssetFolder>
	</PropertyGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="StereoKitTest_Web" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Program.cs"          Visible="false" />
		<Compile Include="..\DebugToolWindow.cs"  Visible="false" />
		<Compile Include="..\ITest.cs"            Visible="false" />
		<Compile Include="..\Tests.cs"            Visible="false" />
		<Compile Include="..\Demos\*.cs"          Visible="false" />
		<Compile Include="..\Tools\*.cs"          Visible="false" />
		<Compile Include="..\Tests\*.cs"          Visible="false" />
		<Compile Include="..\Docs\*.cs"           Visible="false" />
		<Compile Include="..\Guides\*.cs"         Visible="false" Exclude="..\Guides\GuideGettingStarted.cs" />
	</ItemGroup>

	<Import Project="$(MSBuildThisFileDirectory)..\..\..\StereoKit\BuildStereoKitSDK.targets" />

</Project>
